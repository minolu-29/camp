/* ローカルストレージに保存されたユーザー追加の用語を読み込む */
function loadCustomTerms(){
  try{
    const raw = localStorage.getItem('camplab_custom_terms');
    return raw ? JSON.parse(raw) : [];
  }catch(e){ return []; }
}
function saveCustomTerms(list){
  try{ localStorage.setItem('camplab_custom_terms', JSON.stringify(list)); }catch(e){}
}
let customTerms = loadCustomTerms();
function allTerms(){ return [...customTerms, ...terms]; }

function renderDict(list){
  const wrap = document.getElementById('dictList');
  wrap.innerHTML = list.map((t,i)=>`
    <div class="term-card">
      ${t.custom ? `<button class="term-remove" onclick="removeCustomTerm(${t._idx})" title="削除">✕</button>` : ''}
      <div class="term-head">
        <span class="term-jp">${t.jp}</span>
        <span class="term-en">${t.en||''}</span>
      </div>
      <p>${t.desc}</p>
      <span class="term-cat ${t.custom?'custom':''}">${t.cat}${t.custom?' ・ ネット追加':''}</span>
    </div>
  `).join('');
}
function getMergedList(){
  const custom = customTerms.map((t,i)=>({...t, custom:true, _idx:i}));
  return [...custom, ...terms];
}
renderDict(getMergedList());
function filterDict(){
  const q = document.getElementById('dictSearch').value.trim();
  const base = getMergedList();
  if(!q){renderDict(base);return;}
  renderDict(base.filter(t=> t.jp.includes(q) || (t.en||'').toLowerCase().includes(q.toLowerCase()) || t.desc.includes(q)));
}
document.getElementById('dictSearch').addEventListener('input', filterDict);
function removeCustomTerm(idx){
  customTerms.splice(idx,1);
  saveCustomTerms(customTerms);
  renderDict(getMergedList());
}

/* ---------------- 用語追加フォーム ---------------- */
const addForm = document.getElementById('addForm');
document.getElementById('openAddForm').addEventListener('click',()=>{
  addForm.classList.toggle('open');
});
document.getElementById('cancelAddBtn').addEventListener('click',()=>{
  addForm.classList.remove('open');
  document.getElementById('newTermInput').value='';
  document.getElementById('newTermDesc').value='';
  document.getElementById('fetchStatus').textContent='';
});

document.getElementById('fetchWikiBtn').addEventListener('click', async ()=>{
  const term = document.getElementById('newTermInput').value.trim();
  const status = document.getElementById('fetchStatus');
  if(!term){ status.textContent='まず用語を入力してね'; return; }
  status.textContent='ネットで検索中…';
  try{
    const url = `https://ja.wikipedia.org/w/api.php?action=query&list=search&srsearch=${encodeURIComponent(term+' キャンプ')}&format=json&origin=*&srlimit=1`;
    const searchRes = await fetch(url);
    const searchData = await searchRes.json();
    const hit = searchData?.query?.search?.[0];
    if(!hit){ status.textContent='見つからなかった。自分で説明を入力してね。'; return; }
    const extractUrl = `https://ja.wikipedia.org/w/api.php?action=query&prop=extracts&exintro&explaintext&titles=${encodeURIComponent(hit.title)}&format=json&origin=*`;
    const extractRes = await fetch(extractUrl);
    const extractData = await extractRes.json();
    const pages = extractData?.query?.pages || {};
    const page = Object.values(pages)[0];
    let extract = page?.extract || '';
    if(extract.length > 220) extract = extract.slice(0,220) + '…';
    document.getElementById('newTermDesc').value = extract || '説明を取得できなかった。自分で入力してね。';
    status.textContent = `Wikipedia「${hit.title}」から取得しました(自由に編集OK)`;
  }catch(e){
    status.textContent = '通信に失敗した。オフラインか、自分で説明を入力してね。';
  }
});

document.getElementById('saveTermBtn').addEventListener('click',()=>{
  const jp = document.getElementById('newTermInput').value.trim();
  const desc = document.getElementById('newTermDesc').value.trim();
  const cat = document.getElementById('newTermCat').value;
  const status = document.getElementById('fetchStatus');
  if(!jp || !desc){ status.textContent='用語名と説明の両方を入力してね'; return; }
  customTerms.unshift({jp, en:'', cat, desc});
  saveCustomTerms(customTerms);
  renderDict(getMergedList());
  addForm.classList.remove('open');
  document.getElementById('newTermInput').value='';
  document.getElementById('newTermDesc').value='';
  status.textContent='';
});

