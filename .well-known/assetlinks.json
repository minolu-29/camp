const styleLabel = {solo:"ソロ",group:"グルキャン",family:"ファミキャン"};
const seasonLabel = {summer:"☀️ 夏ギア",winter:"❄️ 冬ギア",all:"🍃 オールシーズン"};
let currentGStyle = 'all', currentGSeason = 'all';
function renderGears(){
  const list = gears.filter(g=>
    (currentGStyle==='all' || g.styles.includes(currentGStyle)) &&
    (currentGSeason==='all' || g.season===currentGSeason || g.season==='all')
  );
  document.getElementById('gearCount').textContent = `${list.length}件のギアを表示中`;
  document.getElementById('gearList').innerHTML = list.map(g=>`
    <div class="gear-card">
      <div class="gear-img">${g.emoji}</div>
      <div class="gear-body">
        <h3>${g.name}</h3>
        <p class="gear-price">${g.price}</p>
        <p class="gear-meta">${g.meta}</p>
        <div class="site-tags" style="margin-bottom:10px;">
          <span class="season-tag ${g.season}">${seasonLabel[g.season]}</span>
          ${g.styles.map(s=>`<span class="site-tag">${styleLabel[s]}</span>`).join('')}
        </div>
        <a class="video-link" target="_blank" href="https://www.youtube.com/results?search_query=${encodeURIComponent(g.q)}">▶ 設営動画をYouTubeで見る</a>
      </div>
    </div>
  `).join('');
}
renderGears();
document.querySelectorAll('#gearStyleSwitch .style-btn').forEach(b=>{
  b.addEventListener('click',()=>{
    document.querySelectorAll('#gearStyleSwitch .style-btn').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    currentGStyle = b.dataset.gstyle;
    renderGears();
  });
});
document.querySelectorAll('#gearSeasonSwitch .style-btn').forEach(b=>{
  b.addEventListener('click',()=>{
    document.querySelectorAll('#gearSeasonSwitch .style-btn').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    currentGSeason = b.dataset.gseason;
    renderGears();
  });
});

