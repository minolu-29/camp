  {title:"コンテナボックスでの丸ごとスタッキング",body:"同一サイズのコンテナボックスに調理小物・食器・カトラリーを分けて収納し、積み重ねてそのまま車載するとサイト着後の展開が早い。"},
];
document.getElementById('comboList').innerHTML = combos.map(c=>`
  <div class="tip-card">
    <h3>${c.title}</h3>
    <p>${c.body}</p>
    <span class="tip-source">※編集部キュレーション(静的データ)</span>
  </div>
`).join('');

/* ---------------- スタイル別比較 ---------------- */
const compareData = {
  solo:{
    caption:"荷物量を最小限に、コンパクト・軽量重視",
    rows:[
      ["ソロテント/シェルター","high","1人用・設営が速いものが◎"],
      ["ソロクッカーセット","high","1台で完結するものが人気"],
      ["コンパクトチェア","mid","無くても成立するが快適度UP"],
      ["大型タープ","low","基本は不要。小型ヘキサで十分"],
    ]
  },
  group:{
    caption:"共有ギア中心。人数分より少し多めが基準",
    rows:[
      ["大型タープ","high","共有スペース確保の要"],
      ["ツーバーナー","high","同時調理で待ち時間を削減"],
      ["ローテーブル+チェア(複数)","high","人数分+予備1〜2脚"],
      ["個人用シュラフ・マット","mid","各自持参が基本"],
    ]
  },
  family:{
    caption:"安全性・快適性・収納力のバランス重視",
    rows:[
      ["ツールームテント","high","リビング+寝室を分けられる"],
      ["キッズ用チェア/テーブル","high","高さが合う専用品が安全"],
      ["大容量クーラーボックス","high","食材・飲料の管理がしやすい"],
      ["ソロ用ミニマルギア","low","荷物が増えるので優先度低め"],
    ]
  }
};
function renderCompare(style){
  const d = compareData[style];
  document.getElementById('compareTableWrap').innerHTML = `
    <p style="font-size:13px;color:#5a5344;margin:0 0 10px;">${d.caption}</p>
    <table class="compare">
      <tr><th>ギア</th><th>優先度</th><th>ポイント</th></tr>
      ${d.rows.map(r=>`<tr><td>${r[0]}</td><td class="priority ${r[1]}">${r[1]==='high'?'★★★':r[1]==='mid'?'★★':'★'}</td><td>${r[2]}</td></tr>`).join('')}
    </table>
  `;
}
renderCompare('solo');
document.querySelectorAll('.style-btn').forEach(b=>{
  b.addEventListener('click',()=>{
    document.querySelectorAll('.style-btn').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    renderCompare(b.dataset.style);
  });
});

/* ---------------- キャンプ場検索(サンプルデータ) ---------------- */
const sites = [
  {name:"森のしずくキャンプ場", pref:"山梨県", type:"ファミリー向け", emoji:"🌲", desc:"川遊びができるファミリー人気サイト。管理棟でギアレンタルも可能。", tags:["直火OK","電源サイトあり","ペット可"]},
  {name:"湖畔サイレントベース", pref:"長野県", type:"ソロ向け", emoji:"🏞", desc:"静けさ重視のソロ向けサイト。区画が広く隣サイトとの距離が確保されている。", tags:["静音重視","予約制","場内Wi-Fiなし"]},
  {name:"リバーサイド・グループヴィレッジ", pref:"静岡県", type:"グループ向け", emoji:"🏕", desc:"大型フリーサイトで団体・グルキャンに対応。BBQ設備も充実。", tags:["大型フリーサイト","BBQ設備","駐車場隣接"]},
  {name:"高原の風キャンプ場", pref:"栃木県", type:"ファミリー向け", emoji:"⛰", desc:"標高が高く夏場も快適。子供向け遊具エリアあり。", tags:["夏涼しい","遊具あり","売店あり"]},
  {name:"波音ソロベース", pref:"千葉県", type:"ソロ向け", emoji:"🌊", desc:"海が見えるロケーションのソロ限定サイト。焚き火時間を長く楽しめる。", tags:["オーシャンビュー","ソロ限定","直火不可"]},
];
const prefSel = document.getElementById('prefFilter');
[...new Set(sites.map(s=>s.pref))].forEach(p=>{
  const o = document.createElement('option'); o.value=p; o.textContent=p; prefSel.appendChild(o);
});
function renderSites(){
  const pref = prefSel.value, type = document.getElementById('typeFilter').value;
  const filtered = sites.filter(s=> (!pref||s.pref===pref) && (!type||s.type===type) );
  document.getElementById('siteList').innerHTML = filtered.length ? filtered.map(s=>`
    <div class="site-card">
      <div class="site-emoji">${s.emoji}</div>
      <div>
        <h3>${s.name}</h3>
        <span class="pref">${s.pref} ・ ${s.type}</span>
        <p>${s.desc}</p>
        <div class="site-tags">${s.tags.map(t=>`<span class="site-tag">${t}</span>`).join('')}</div>
      </div>
    </div>
  `).join('') : `<p style="font-size:13px;color:#9c9384;">条件に合うキャンプ場が見つかりませんでした。</p>`;
}
prefSel.addEventListener('change', renderSites);
document.getElementById('typeFilter').addEventListener('change', renderSites);
renderSites();
</script>
</body>
</html>
